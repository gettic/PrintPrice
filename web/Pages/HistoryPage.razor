@* Price history (desktop HistoryForm on the web): search, month, Show and Printer filters, six month cards, the list
   (a table on wide screens, cards on a phone) with For / Note / Printed / Failed changed in place, Delete, Open again and
   Repeat print. The list is the Calculator's; every change is saved at once by its Changed callback.
   Idea 22: tick boxes (delete several, Calculator's DeleteMany), Clear all (ClearAll, safety copy), Undo bar, a picture per
   quote (filled by HistoryPage.razor.js from IndexedDB) and List / Medium / Large views (Settings.HistoryView). *@

@inject IJSRuntime JS
@inject HistoryStore Histories
@implements IAsyncDisposable

@{
    Work();   // the sums and the filtered list, worked out again only when something they use changed
    var names = cNames;
    var allPrinters = cAllPrinters;
    bool printerMode = allPrinters.Count >= 2;
    var months = cMonths;
    var rows = cRows;
    var cards = cCards;
    int monthIndex = filter.Month == DateTime.MinValue ? -1 : months.IndexOf(filter.Month);
    if (selected != null && !rows.Contains(selected)) selected = null;
    if (selected == null && rows.Count > 0) selected = rows[0];
    int view = WebHistory.View(Settings);
    bool listView = view == WebHistory.ViewList || printing;   // printing always uses the list
    bool allTicked = rows.Count > 0 && ticked.Count == rows.Count;
}

<div class="filters">
    <input type="search" class="search" placeholder="@L.S("Model, link, note or name", "Model, link, note eller navn")"
           aria-label="@L.S("Search", "Søg")" value="@filter.Query" @oninput='e => { filter.Query = (string)e.Value; shown = WebHistory.ShowStep; }' />
    <label class="cap" for="hmonth">@L.S("Month", "Måned")</label>
    <span class="month">
        <select id="hmonth" @onchange="MonthChosen">
            <option value="" selected="@(filter.Month == DateTime.MinValue)">@L.S("All months", "Alle måneder")</option>
            @foreach (var m in months)
            {
                <option value="@m.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture)" selected="@(m == filter.Month)">@WebHistory.MonthText(m)</option>
            }
        </select>
        <button class="small" title="@L.S("Older month", "Ældre måned")" aria-label="@L.S("Older month", "Ældre måned")"
                disabled="@(monthIndex >= months.Count - 1 || months.Count == 0)" @onclick="() => StepMonth(months, monthIndex, +1)">‹</button>
        <button class="small" title="@L.S("Newer month", "Nyere måned")" aria-label="@L.S("Newer month", "Nyere måned")"
                disabled="@(monthIndex < 0 && filter.Month == DateTime.MinValue)" @onclick="() => StepMonth(months, monthIndex, -1)">›</button>
    </span>
    <label class="cap" for="hshow">@L.S("Show", "Vis")</label>
    <select id="hshow" @onchange='e => { filter.Show = int.Parse((string)e.Value); shown = WebHistory.ShowStep; }'>
        <option value="0" selected="@(filter.Show == 0)">@L.S("All quotes", "Alle tilbud")</option>
        <option value="1" selected="@(filter.Show == 1)">@L.S("Friends & family", "Venner og familie")</option>
        <option value="2" selected="@(filter.Show == 2)">@L.S("Customers", "Kunder")</option>
        <option value="3" selected="@(filter.Show == 3)">@L.S("Failed", "Fejlede")</option>
        <option value="4" selected="@(filter.Show == 4)">@L.S("Not printed", "Ikke printet")</option>
    </select>
    @if (printerMode)
    {
        <label class="cap" for="hprinter">@L.S("Printer", "Printer")</label>
        <select id="hprinter" @onchange='e => { string v = (string)e.Value; filter.PrinterId = v.Length == 0 ? null : v; shown = WebHistory.ShowStep; }'>
            <option value="" selected="@(filter.PrinterId == null)">@L.S("All printers", "Alle printere")</option>
            @foreach (var t in allPrinters)
            {
                <option value="@t.Id" selected="@(t.Id == filter.PrinterId)">@WebHistory.PrinterChoiceText(t)</option>
            }
        </select>
    }
    <span class="count" role="status">@WebHistory.CountText(rows.Count, Quotes.Count)</span>
    @if (Quotes.Count > 0)
    {
        @if (narrow == true)
        {
            <button class="@(selectMode ? "small accent" : "small")" aria-pressed="@selectMode" @onclick="ToggleSelectMode">@(selectMode ? L.S("Done", "Færdig") : L.S("Select", "Vælg"))</button>
        }
        <span class="views" role="group" aria-label="@L.S("View", "Visning")">
            <button class="@(view == WebHistory.ViewList ? "on" : "")" aria-pressed="@(view == WebHistory.ViewList)" title="@L.S("List", "Liste")" @onclick="() => SetView(WebHistory.ViewList)">☰<span class="vt"> @L.S("List", "Liste")</span></button>
            <button class="@(view == WebHistory.ViewMedium ? "on" : "")" aria-pressed="@(view == WebHistory.ViewMedium)" title="@L.S("Medium pictures", "Mellemstore billeder")" @onclick="() => SetView(WebHistory.ViewMedium)">▦<span class="vt"> @L.S("Medium", "Mellem")</span></button>
            <button class="@(view == WebHistory.ViewLarge ? "on" : "")" aria-pressed="@(view == WebHistory.ViewLarge)" title="@L.S("Large pictures", "Store billeder")" @onclick="() => SetView(WebHistory.ViewLarge)">▣<span class="vt"> @L.S("Large", "Store")</span></button>
        </span>
    }
</div>

<div class="cards">
    @for (int i = 0; i < cards.Count; i++)
    {
        var c = cards[i];
        <div class="@(i == 5 ? "card profit" : "card")" title="@c.Tip">
            <div class="cap"><span class="long">@c.Caption</span><span class="short">@(c.ShortCaption.Length > 0 ? c.ShortCaption : c.Caption)</span></div>
            <div class="val @c.Css"><span class="long">@c.Value</span><span class="short">@(c.ShortValue.Length > 0 ? c.ShortValue : c.Value)</span></div>
            <div class="sub"><span class="long">@c.Sub</span><span class="short">@(c.ShortSub.Length > 0 ? c.ShortSub : c.Sub)</span></div>
        </div>
    }
</div>

@if (DoneText != null)
{
    <div class="@(DoneError ? "hinfo done error" : "hinfo done ok")" role="status">
        <span>@DoneText@if (SafetyCopy != null) { <span class="muted">@(" " + L.S("Safety copy:", "Sikkerhedskopi:") + " " + WebBackup.SafetyFileName(SafetyCopy))</span> }</span>
        @if (SafetyCopy != null) { <button class="small" @onclick="() => DownloadSafety.InvokeAsync()">@L.S("Download", "Hent")</button> }
        @if (CanUndo) { <button class="small" @onclick="UndoClicked">@L.S("Undo", "Fortryd")</button> }
        <button class="small x" aria-label="@L.S("Close", "Luk")" title="@L.S("Close", "Luk")" @onclick="() => DismissDone.InvokeAsync()">✕</button>
    </div>
}

@if (Quotes.Count == 0)
{
    <div class="empty">@L.S("No saved quotes yet. On the Calculator page, Save to history keeps the quote on screen here; Backup… below restores a backup.",
                            "Ingen gemte tilbud endnu. På Beregner-siden gemmer Gem i historik tilbuddet på skærmen her; Sikkerhedskopi… nedenfor gendanner en kopi.")</div>
}
else
{
    @* idea 22: the ticked quotes' bar, and "Tick all" where the list has no header box (cards, phone select mode) *@
    @if (ticked.Count > 0 || (selectMode && narrow == true) || (!listView && narrow != true))
    {
        <div class="@(ticked.Count > 0 ? "selbar on" : "selbar")">
            @if (!listView || narrow == true)
            {
                <label class="check tickall"><input type="checkbox" class="sel" checked="@allTicked" @onchange="() => TickAll(rows, allTicked)" />
                    <span>@L.S("Tick all shown", "Markér alle viste")</span></label>
            }
            @if (ticked.Count > 0)
            {
                <b>@WebHistory.TickedText(ticked.Count)</b>
                <span class="muted">· @Num.Kr(WebHistory.Total(ticked))</span>
                <span class="grow"></span>
                <button class="small" @onclick="ClearTicks">@L.S("Clear selection", "Fjern markering")</button>
                <button class="small accent" @onclick="() => AskDelete(rows)">@WebHistory.DeleteTickedText(ticked.Count)</button>
            }
        </div>
    }

    @if (listView)
    {
    @* app.css shows the table on wide screens and the cards on a phone: only the shown one is built (both until the
       page knows which, and while printing) *@
    @if (narrow != true || printing)
    {
    <table class="hist">
        <thead>
            <tr>
                <th class="c selcol"><input type="checkbox" class="sel" checked="@allTicked" aria-label="@L.S("Tick all shown", "Markér alle viste")"
                                           title="@L.S("Tick all shown", "Markér alle viste")" @onchange="() => TickAll(rows, allTicked)" /></th>
                <th class="piccol"><span class="vh">@L.S("Picture", "Billede")</span></th>
                <th>@L.S("Date", "Dato")</th><th>@L.S("Model", "Model")</th><th class="n">@L.S("Time", "Tid")</th>
                <th class="n">@L.S("Grams", "Gram")</th><th class="n">@L.S("Price", "Pris")</th><th>@L.S("For", "Til")</th>
                @if (printerMode) { <th>@L.S("Printer", "Printer")</th> }
                <th>@L.S("Note", "Note")</th><th class="c">@L.S("Printed", "Printet")</th><th class="c">@L.S("Failed", "Fejlet")</th>
                <th>@L.S("Invoice", "Faktura")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Shown(rows))
            {
                var rec = r;
                bool friends = WebHistory.IsFriends(rec);
                bool isTicked = ticked.Contains(rec);
                <tr class="@(rec == selected ? "picked" : isTicked ? "ticked" : "")" tabindex="0" @key="rec"
                    @onclick="() => Select(rec)" @ondblclick="() => OpenAgain.InvokeAsync(rec)" @onkeydown="e => RowKey(e, rec)">
                    <td class="c selcol" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
                        <input type="checkbox" class="sel" checked="@isTicked" aria-label="@L.F("Tick {0}", "Markér {0}", WebHistory.ModelText(rec))"
                               @onchange="() => Tick(rec)" @onkeydown:stopPropagation="true" /></td>
                    <td class="piccol">@Pic(rec, "s")</td>
                    <td>@WebHistory.DateText(rec)</td>
                    <td class="model" title="@WebHistory.ModelText(rec)">@WebHistory.ModelText(rec)</td>
                    <td class="n">@WebHistory.TimeText(rec)</td>
                    <td class="n">@WebHistory.GramsText(rec)</td>
                    <td class="n"><b class="@(friends ? "green" : "red")">@WebHistory.PriceText(rec)</b></td>
                    <td><select class="for @(friends ? "green" : "red")" aria-label="@L.S("For", "Til")" @onchange="e => ForChosen(rec, e)">
                            <option value="1" selected="@friends">@WebHistory.ForText(History.ForFriends)</option>
                            <option value="2" selected="@(!friends)">@WebHistory.ForText(History.ForCustomer)</option>
                        </select></td>
                    @if (printerMode) { <td class="printer" title="@WebHistory.PrinterText(rec, names)">@WebHistory.PrinterText(rec, names)</td> }
                    <td class="notecell"><input type="text" class="left" maxlength="@WebHistory.MaxNote" value="@rec.Note" aria-label="@L.S("Note", "Note")"
                                                title="@rec.Note" @onchange="e => NoteChanged(rec, e)" @onkeydown:stopPropagation="true" /></td>
                    <td class="c"><button class="@(rec.Printed ? "tick on" : "tick")" aria-pressed="@rec.Printed" aria-label="@L.S("Printed", "Printet")"
                                          @onclick="() => TogglePrinted(rec)" @onclick:stopPropagation="true">@(rec.Printed ? "✓" : "")</button></td>
                    <td class="c"><button class="@(rec.Failed ? "tick x" : "tick")" aria-pressed="@rec.Failed" aria-label="@L.S("Failed", "Fejlet")"
                                          @onclick="() => ToggleFailed(rec)" @onclick:stopPropagation="true">@(rec.Failed ? "✗" : "")</button></td>
                    <td class="muted">@rec.InvoiceNo</td>
                </tr>
            }
        </tbody>
    </table>
    }

    @* phone: one card per quote; a tap opens its actions *@
    @if (narrow != false || printing)
    {
    <div class="cardlist">
        @foreach (var r in Shown(rows))
        {
            var rec = r;
            bool friends = WebHistory.IsFriends(rec);
            bool open = rec == opened && !selectMode;
            bool isTicked = ticked.Contains(rec);
            string extra = (printerMode ? WebHistory.PrinterText(rec, names) : "") + (printerMode && rec.Note.Length > 0 ? " · " : "") + rec.Note;
            <div class="@("qrow" + (open ? " open" : "") + (isTicked ? " ticked" : ""))" @key="rec" @onclick="() => PhoneTap(rec)">
                <div class="qpic">@Pic(rec, "m")
                    @if (selectMode)
                    {
                        <input type="checkbox" class="sel" checked="@isTicked" aria-label="@L.F("Tick {0}", "Markér {0}", WebHistory.ModelText(rec))"
                               @onclick:stopPropagation="true" @onchange="() => Tick(rec)" />
                    }
                </div>
                <div class="m">@WebHistory.ModelText(rec)</div>
                <div class="p @(friends ? "green" : "red")">@Num.Kr(History.PriceFor(rec))</div>
                <div class="d">@WebHistory.ShortDate(rec) · @WebHistory.TimeText(rec) · @WebHistory.GramsText(rec) g</div>
                <div class="d r @(friends ? "green" : "red")">@WebHistory.ForText(rec.For)</div>
                @if (extra.Length > 0) { <div class="d wide">@extra</div> }
                <div class="chips">
                    <button class="@(rec.Printed ? "chip on" : "chip")" aria-pressed="@rec.Printed" @onclick="() => TogglePrinted(rec)" @onclick:stopPropagation="true">@(rec.Printed ? "✓ " : "")@L.S("Printed", "Printet")</button>
                    <button class="@(rec.Failed ? "chip bad" : "chip")" aria-pressed="@rec.Failed" @onclick="() => ToggleFailed(rec)" @onclick:stopPropagation="true">@(rec.Failed ? "✗ " : "")@L.S("Failed", "Fejlet")</button>
                    @if (rec.InvoiceNo.Length > 0) { <span class="chip">@rec.InvoiceNo</span> }
                </div>
                @if (open) { @Sheet(rec, rows) }
            </div>
        }
    </div>
    }
    }
    else
    {
        @* idea 22: medium / large picture cards (wide screens and phones); a click picks, a tap on a phone opens the actions *@
        bool large = view == WebHistory.ViewLarge;
        // phone: the opened card's actions come full width after its row (Medium = 2 a row, Large = 1), cards keep their order
        int shownCount = Math.Min(shown, rows.Count);
        int openAt = opened != null && narrow == true && !selectMode ? rows.IndexOf(opened) : -1;
        if (openAt >= shownCount) openAt = -1;
        int sheetAfter = openAt < 0 ? -1 : Math.Min(large ? openAt : (openAt | 1), shownCount - 1);
        int tileIndex = -1;
        <div class="@(large ? "tiles large" : "tiles medium")">
            @foreach (var r in Shown(rows))
            {
                var rec = r;
                tileIndex++;
                bool friends = WebHistory.IsFriends(rec);
                bool isTicked = ticked.Contains(rec);
                bool open = rec == opened && narrow == true && !selectMode;
                string css = "tile" + (rec == selected && narrow != true ? " picked" : "") + (isTicked ? " ticked" : "") + (open ? " open" : "")
                             + (ticked.Count > 0 || selectMode ? " selecting" : "");
                <div class="@css" @key="rec" tabindex="0" @onclick="() => TileTap(rec)" @ondblclick="() => OpenAgain.InvokeAsync(rec)" @onkeydown="e => TileKey(e, rec)">
                    <div class="tpic">
                        @Pic(rec, large ? "l" : "t")
                        <span class="tsel" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
                            <input type="checkbox" class="sel" checked="@isTicked" aria-label="@L.F("Tick {0}", "Markér {0}", WebHistory.ModelText(rec))"
                                   @onchange="() => Tick(rec)" @onkeydown:stopPropagation="true" /></span>
                        @if (!large && (rec.Printed || rec.Failed))
                        {
                            <span class="flags">
                                @if (rec.Printed) { <span class="flag on" title="@L.S("Printed", "Printet")">✓</span> }
                                @if (rec.Failed) { <span class="flag bad" title="@L.S("Failed", "Fejlet")">✗</span> }
                            </span>
                        }
                    </div>
                    <div class="m" title="@WebHistory.ModelText(rec)">@WebHistory.ModelText(rec)</div>
                    @if (large)
                    {
                        string extra = (printerMode ? WebHistory.PrinterText(rec, names) : "");
                        if (rec.Note.Length > 0) extra += (extra.Length > 0 ? " · " : "") + rec.Note;
                        if (rec.InvoiceNo.Length > 0) extra += (extra.Length > 0 ? " · " : "") + rec.InvoiceNo;
                        <div class="row"><span class="p @(friends ? "green" : "red")">@Num.Kr(History.PriceFor(rec))</span>
                            <span class="@(friends ? "green" : "red")">@WebHistory.ForText(rec.For)</span></div>
                        <div class="d">@WebHistory.DateText(rec) · @WebHistory.TimeText(rec) · @WebHistory.GramsText(rec) g</div>
                        <div class="d" title="@extra">@(extra.Length > 0 ? extra : " ")</div>
                        <div class="chips">
                            <button class="@(rec.Printed ? "chip on" : "chip")" aria-pressed="@rec.Printed" @onclick="() => TogglePrinted(rec)" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">@(rec.Printed ? "✓ " : "")@L.S("Printed", "Printet")</button>
                            <button class="@(rec.Failed ? "chip bad" : "chip")" aria-pressed="@rec.Failed" @onclick="() => ToggleFailed(rec)" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">@(rec.Failed ? "✗ " : "")@L.S("Failed", "Fejlet")</button>
                        </div>
                    }
                    else
                    {
                        string sub = rec.Note.Length > 0 ? rec.Note : (rec.Customer ?? "");
                        <div class="row"><span class="p @(friends ? "green" : "red")">@Num.Kr(History.PriceFor(rec))</span>
                            <span class="d">@WebHistory.GramsText(rec) g</span></div>
                        <div class="d" title="@(sub.Length > 0 ? sub : null)">@WebHistory.ShortDate(rec) · @WebHistory.TimeText(rec)</div>
                    }
                </div>
                @if (tileIndex == sheetAfter)
                {
                    <div class="tile-sheet" @key="@("sheet")">
                        <div class="tsname">@WebHistory.ModelText(opened)</div>
                        @Sheet(opened, rows)
                    </div>
                }
            }
        </div>
    }

    @if (rows.Count > shown)
    {
        <div class="more"><button @onclick="() => shown += WebHistory.ShowStep">@L.F("Show {0} more", "Vis {0} mere", Math.Min(WebHistory.ShowStep, rows.Count - shown))</button></div>
    }

    <div class="actions">
        <button class="@(armed != null && armed == selected ? "accent" : "")" disabled="@(selected == null)"
                @onclick="() => DeleteClicked(selected, rows)">@(armed != null && armed == selected ? ConfirmText : L.S("Delete", "Slet"))</button>
        <span class="grow"></span>
        <button disabled="@(selected == null)" @onclick="() => Quote.InvokeAsync(selected)">@L.S("Quote…", "Tilbud…")</button>
        <button disabled="@(selected == null)" @onclick="() => Invoice.InvokeAsync(selected)">@L.S("Invoice…", "Faktura…")</button>
        <button disabled="@(selected == null)" @onclick="() => Repeat.InvokeAsync(selected)">@L.S("Repeat print", "Print igen")</button>
        <button class="accent" disabled="@(selected == null)" @onclick="() => OpenAgain.InvokeAsync(selected)">@L.S("Open again", "Åbn igen")</button>
    </div>
}

@{
    bool warnBackup;
    string lastText = WebBackup.LastBackupText(LastBackup, DateTime.Now, Quotes.Count, out warnBackup);
}
<div class="@(warnBackup ? "lastbackup warn" : "lastbackup")">
    <span>@lastText@(warnBackup ? L.S(" – this browser may delete its storage (Safari after 7 days without a visit), so back up now and then.",
                                       " – denne browser kan slette sit lager (Safari efter 7 dage uden besøg), så tag en kopi en gang imellem.") : "")</span>
    @if (Quotes.Count > 0) { <button @onclick="AskClear">@L.S("Clear all…", "Ryd alt…")</button> }
    <button @onclick="() => OpenBackup.InvokeAsync()">@L.S("Backup…", "Sikkerhedskopi…")</button>
</div>

@* idea 22: Delete N ticked… / Clear all… ask first *@
@if (confirm != null)
{
    List<string> warnings;
    var lines = WebHistory.ConfirmLines(confirm.Summary, confirm.Records, confirm.Clear, out warnings);
    @* HistoryPage.razor.js holdDialog: focus on Cancel, Tab stays inside, Esc anywhere = Cancel (data-cancel) *@
    <div class="overlay" @onclick="CancelConfirm" @onkeydown="ConfirmKey">
        <div class="dialog confirm" role="alertdialog" aria-modal="true" aria-labelledby="hc-title" @ref="dialogRef" @onclick:stopPropagation="true">
            <div class="title">
                <span id="hc-title">@WebHistory.ConfirmTitle(confirm.Summary.Count, confirm.Clear)</span>
                <button @onclick="CancelConfirm" aria-label="@L.S("Close", "Luk")">✕</button>
            </div>
            <div class="cbody">
                @foreach (var line in lines) { <p>@line</p> }
                @foreach (var w in warnings) { <p class="warntext">@w</p> }
                @if (confirm.Clear)
                {
                    @if (StorageAvailable)
                    {
                        <label class="check"><input type="checkbox" checked="@keepCopy" @onchange="e => keepCopy = (bool)e.Value" />
                            <span>@L.S("Keep a safety copy first (in this browser, with the pictures; you can download it afterwards)",
                                       "Gem en sikkerhedskopi først (i denne browser, med billederne; du kan hente den bagefter)")</span></label>
                    }
                    else
                    {
                        <p class="warntext">@L.S("This browser keeps no storage, so no safety copy can be made. Use Backup… first if you want one.",
                                                 "Denne browser gemmer intet, så der kan ikke laves en sikkerhedskopi. Brug Sikkerhedskopi… først, hvis du vil have en.")</p>
                    }
                }
                <p class="muted">@L.S("You can undo it until the page is reloaded.", "Du kan fortryde, indtil siden genindlæses.")</p>
            </div>
            <div class="buttons">
                <button data-cancel="1" @onclick="CancelConfirm">@L.S("Cancel", "Annullér")</button>
                <button class="accent" disabled="@busy" @onclick="ConfirmClicked">@WebHistory.ConfirmButton(confirm.Summary.Count, confirm.Clear)</button>
            </div>
        </div>
    </div>
}
@if (Problem != null)
{
    <div class="hinfo warn" role="alert">@Problem</div>
}
@if (Quotes.Count > 0 && narrow == true)
{
    @* phone: tap wording, no click / double-click *@
    <div class="hinfo">@L.S("Tap a quote for its actions: Open again loads it as saved, Repeat print with today's prices (time and grams as saved), Quote… makes a quote page and Invoice… a bill (it ticks Printed). Printed and Failed change with a tap; changes are saved at once. Select ticks quotes to delete several at once; Clear all… deletes every quote after a safety copy. Both can be undone until the page is reloaded.",
                           "Tryk på et tilbud for at se dets handlinger: Åbn igen henter det som gemt, Print igen med dagens priser (tid og gram som gemt), Tilbud… laver et tilbud og Faktura… en regning (den sætter Printet). Printet og Fejlet ændres med et tryk; ændringer gemmes med det samme. Vælg markerer tilbud, så du kan slette flere på én gang; Ryd alt… sletter alle tilbud efter en sikkerhedskopi. Begge kan fortrydes, indtil siden genindlæses.")</div>
}
else if (Quotes.Count > 0)
{
<div class="hinfo">@L.S("Quote… makes a quote page for the selected print, Invoice… a bill (it ticks Printed). Click For, Note, Printed or Failed to change them; changes are saved at once. Open again (or double-click) loads a quote as saved; Repeat print loads it with today's prices (time and grams as saved: drop the sliced file again to update them). Tick quotes to delete several at once; Clear all… deletes every quote after a safety copy. Both can be undone until the page is reloaded.",
                       "Tilbud… laver et tilbud på det valgte print, Faktura… en regning (den sætter Printet). Klik på Til, Note, Printet eller Fejlet for at ændre dem; ændringer gemmes med det samme. Åbn igen (eller dobbeltklik) henter et tilbud som gemt; Print igen henter det med dagens priser (tid og gram som gemt: slip den slicede fil igen for at opdatere dem). Markér tilbud for at slette flere på én gang; Ryd alt… sletter alle tilbud efter en sikkerhedskopi. Begge kan fortrydes, indtil siden genindlæses.")</div>
}
<div class="note">@L.S("Your history is kept in this browser only (about 1 KB per quote). Clearing the browser's site data deletes it.",
                       "Din historik gemmes kun i denne browser (ca. 1 KB pr. tilbud). Sletter du browserens webstedsdata, slettes den.")</div>

@code {
    [Parameter] public List<QuoteRecord> Quotes { get; set; }
    [Parameter] public AppSettings Settings { get; set; }
    [Parameter] public string Problem { get; set; }
    /// After any change to a record or the list (the Calculator saves it and recalculates).
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback<QuoteRecord> OpenAgain { get; set; }
    [Parameter] public EventCallback<QuoteRecord> Repeat { get; set; }
    /// Quote… / Invoice…: the saved quote's page (the Calculator opens it).
    [Parameter] public EventCallback<QuoteRecord> Quote { get; set; }
    [Parameter] public EventCallback<QuoteRecord> Invoice { get; set; }
    /// WebBackup.LastBackupValue of the newest backup ("" = never) and Backup… (the Backup dialog).
    [Parameter] public string LastBackup { get; set; }
    [Parameter] public EventCallback OpenBackup { get; set; }

    // idea 22: delete several / Clear all / Undo are the Calculator's (the undo lasts while the page is open, also on the
    // Calculator tab); its done bar comes back here as DoneText.
    [Parameter] public EventCallback<List<QuoteRecord>> DeleteMany { get; set; }
    /// Clear all; true = keep a safety copy first.
    [Parameter] public EventCallback<bool> ClearAll { get; set; }
    [Parameter] public EventCallback Undo { get; set; }
    [Parameter] public EventCallback DismissDone { get; set; }
    [Parameter] public string DoneText { get; set; }
    [Parameter] public bool DoneError { get; set; }
    [Parameter] public bool CanUndo { get; set; }
    /// The Clear all safety copy's key (null = none) and its Download.
    [Parameter] public string SafetyCopy { get; set; }
    [Parameter] public EventCallback DownloadSafety { get; set; }
    /// false = this browser keeps no storage (no pictures, no safety copy).
    [Parameter] public bool StorageAvailable { get; set; } = true;
    /// After Settings.HistoryView changed (the Calculator saves the settings).
    [Parameter] public EventCallback SettingsChanged { get; set; }

    readonly WebHistory.Filter filter = new WebHistory.Filter();
    QuoteRecord selected, opened, armed;
    int shown = WebHistory.ShowStep;
    int armCount;

    static string ConfirmText { get { return L.S("Really delete?", "Slet virkelig?"); } }

    // ---------- worked-out values kept between redraws (a click that changes nothing doesn't redo the sums) ----------

    Dictionary<string, string> cNames;
    List<PrinterTotals> cAllPrinters;
    List<DateTime> cMonths;
    List<QuoteRecord> cRows;
    List<WebHistory.Card> cCards;

    // what they were worked out from: the records' fields that can change in place, the list, settings' printers,
    // language and the filter
    struct Seen
    {
        public QuoteRecord R;
        public int For, Hours, Minutes;
        public bool Printed, Failed;
        public double PaidBack, Grams, FriendsPrice, OthersPrice;
        public string SavedAt, Note, Customer, InvoiceNo, FailedAt, PrinterId, PrinterName, PrinterModel;

        public Seen(QuoteRecord r)
        {
            R = r; For = r.For; Hours = r.Hours; Minutes = r.Minutes; Printed = r.Printed; Failed = r.Failed;
            PaidBack = r.PaidBack; Grams = r.Grams; FriendsPrice = r.FriendsPrice; OthersPrice = r.OthersPrice;
            SavedAt = r.SavedAt; Note = r.Note; Customer = r.Customer; InvoiceNo = r.InvoiceNo; FailedAt = r.FailedAt;
            PrinterId = r.PrinterId; PrinterName = r.PrinterName; PrinterModel = r.PrinterModel;
        }

        // strings by reference: a changed field is a new string (an equal new one only means one extra recount)
        public bool Same(QuoteRecord r)
        {
            return ReferenceEquals(R, r) && For == r.For && Hours == r.Hours && Minutes == r.Minutes && Printed == r.Printed
                && Failed == r.Failed && PaidBack.Equals(r.PaidBack) && Grams.Equals(r.Grams) && FriendsPrice.Equals(r.FriendsPrice)
                && OthersPrice.Equals(r.OthersPrice) && ReferenceEquals(SavedAt, r.SavedAt) && ReferenceEquals(Note, r.Note)
                && ReferenceEquals(Customer, r.Customer) && ReferenceEquals(InvoiceNo, r.InvoiceNo) && ReferenceEquals(FailedAt, r.FailedAt)
                && ReferenceEquals(PrinterId, r.PrinterId) && ReferenceEquals(PrinterName, r.PrinterName) && ReferenceEquals(PrinterModel, r.PrinterModel);
        }
    }

    Seen[] seen;
    List<QuoteRecord> seenList;
    AppSettings seenSettings;
    string seenPrinters;
    bool seenDanish;
    DateTime seenMonth, cardsMonth;
    int seenShow;
    string seenPrinterId, seenQuery, cardsPrinterId;

    static string PrintersKey(AppSettings s)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append(s.ActivePrinterId).Append('\n').Append(s.PrinterName).Append('\n').Append(s.PrinterModel);
        foreach (var p in s.Printers) sb.Append('\n').Append(p.Id).Append('\t').Append(p.Name).Append('\t').Append(p.Model);
        return sb.ToString();
    }

    bool DataChanged()
    {
        string printers = PrintersKey(Settings);
        bool same = seen != null && ReferenceEquals(seenList, Quotes) && seen.Length == Quotes.Count && ReferenceEquals(seenSettings, Settings)
                    && seenPrinters == printers && seenDanish == L.Danish;
        for (int i = 0; same && i < seen.Length; i++) same = seen[i].Same(Quotes[i]);
        if (same) return false;
        seen = new Seen[Quotes.Count];
        for (int i = 0; i < seen.Length; i++) seen[i] = new Seen(Quotes[i]);
        seenList = Quotes;
        seenSettings = Settings;
        seenPrinters = printers;
        seenDanish = L.Danish;
        return true;
    }

    /// The values the page shows, as before worked out on every redraw, now only when what they use changed.
    void Work()
    {
        bool data = DataChanged();
        if (data)
        {
            cNames = WebHistory.PrinterNames(Quotes, Settings, out cAllPrinters);
            cMonths = History.Months(Quotes);
        }
        bool printerMode = cAllPrinters.Count >= 2;
        if (!printerMode) filter.PrinterId = null;
        if (data || cRows == null || filter.Month != seenMonth || filter.Show != seenShow || filter.PrinterId != seenPrinterId || filter.Query != seenQuery)
        {
            cRows = WebHistory.Apply(Quotes, filter, printerMode ? cNames : null);
            ticked = WebHistory.KeepTicks(ticked, cRows);   // only shown rows stay ticked; a reloaded list keeps them by Id
        }
        if (data) picturesStale = true;
        if (data || cCards == null || filter.Month != cardsMonth || filter.PrinterId != cardsPrinterId)
        {
            cCards = WebHistory.Cards(WebHistory.Totals(Quotes, filter.Month, filter.PrinterId));
            cCards[5].Tip = WebHistory.ProfitTip(Quotes, Settings, filter.Month, printerMode, filter.PrinterId);
            cardsMonth = filter.Month;
            cardsPrinterId = filter.PrinterId;
        }
        seenMonth = filter.Month;
        seenShow = filter.Show;
        seenPrinterId = filter.PrinterId;
        seenQuery = filter.Query;
    }

    // ---------- which list app.css shows (HistoryPage.razor.js): build only that one ----------

    bool? narrow;    // true = phone cards (max-width 720px), false = table, null = not known yet (both)
    bool printing;   // both while printing (the paper's width decides there)
    IJSObjectReference module;
    DotNetObjectReference<HistoryPage> self;
    static int lastWatchKey;
    readonly int watchKey = ++lastWatchKey;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                self = DotNetObjectReference.Create(this);
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/HistoryPage.razor.js");
                narrow = await module.InvokeAsync<bool>("watchNarrow", self, watchKey);
                if (disposed) { await module.InvokeVoidAsync("stopNarrow", watchKey); return; }   // the page closed meanwhile
                if (StorageAvailable) { await module.InvokeVoidAsync("watchPictures"); watchingPictures = true; }
                StateHasChanged();
            }
            catch (Exception) { narrow = null; }   // no module: both lists, as always
        }
        // the confirm dialog: focus on Cancel, Tab kept inside, Esc anywhere (W2); let go when it closed
        if (module != null && !disposed)
        {
            try
            {
                if (confirm != null && holdPending) { holdPending = false; dialogHeld = true; await module.InvokeVoidAsync("holdDialog", dialogRef); }
                else if (confirm == null && dialogHeld) { dialogHeld = false; await module.InvokeVoidAsync("releaseDialog"); }
            }
            catch (Exception) { }
        }
        if (picturesStale && !loadingPictures && !disposed)
        {
            // which quotes have a picture (keys only); the pictures themselves are read by HistoryPage.razor.js
            picturesStale = false;
            loadingPictures = true;
            var ids = StorageAvailable ? await Histories.PictureIds() : new HashSet<string>(StringComparer.Ordinal);
            loadingPictures = false;
            if (disposed) return;
            if (pictureIds == null || !pictureIds.SetEquals(ids)) { pictureIds = ids; StateHasChanged(); }
        }
    }

    // ---------- idea 22: pictures, views, ticks, delete several / Clear all ----------

    HashSet<string> pictureIds;      // record ids with a picture here (null = not known yet: the picture boxes wait)
    bool picturesStale = true, loadingPictures, watchingPictures;
    HashSet<QuoteRecord> ticked = new HashSet<QuoteRecord>();
    bool selectMode;                 // phone: a tap ticks instead of opening

    bool HasPicture(QuoteRecord r)
    {
        if (!StorageAvailable || r == null || !History.SafePictureId(r.Id)) return false;
        return pictureIds == null || pictureIds.Contains(r.Id);
    }

    /// The quote's picture box: s = list (38 px, bigger on hover), m = phone list, t = medium card, l = large card.
    /// The img has no src here: HistoryPage.razor.js fills it from IndexedDB when it comes near the screen.
    RenderFragment Pic(QuoteRecord r, string size) =>
        @<span class="@("hpic " + size)">@if (HasPicture(r)) { <img data-pic="@r.Id" alt="" decoding="async" draggable="false" /> }
                                       else if (pictureIds != null || !StorageAvailable)
                                       {
                                           @* the desktop's placeholder (HistoryViews.DrawWell): an isometric cube outline, half the box *@
                                           <svg class="cube" viewBox="0 0 100 100" role="img" aria-label="@L.S("No picture", "Intet billede")"><path vector-effect="non-scaling-stroke" d="M50 25 L71.65 37.5 L71.65 62.5 L50 75 L28.35 62.5 L28.35 37.5 Z M28.35 37.5 L50 50 L71.65 37.5 M50 50 L50 75" /></svg>
                                       }</span>;

    /// A quote's actions on a phone (list row or card tapped).
    RenderFragment Sheet(QuoteRecord rec, List<QuoteRecord> rows)
    {
        bool friends = WebHistory.IsFriends(rec);
        return @<div class="sheet" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
            <label>@L.S("For", "Til")
                <select class="@(friends ? "green" : "red")" @onchange="e => ForChosen(rec, e)">
                    <option value="1" selected="@friends">@WebHistory.ForText(History.ForFriends)</option>
                    <option value="2" selected="@(!friends)">@WebHistory.ForText(History.ForCustomer)</option>
                </select></label>
            <label>@L.S("Note", "Note")
                <input type="text" class="left" maxlength="@WebHistory.MaxNote" value="@rec.Note" @onchange="e => NoteChanged(rec, e)" /></label>
            <button class="accent" @onclick="() => OpenAgain.InvokeAsync(rec)">@L.S("Open again", "Åbn igen")</button>
            <button @onclick="() => Repeat.InvokeAsync(rec)">@L.S("Repeat print", "Print igen")</button>
            <button @onclick="() => Quote.InvokeAsync(rec)">@L.S("Quote…", "Tilbud…")</button>
            <button @onclick="() => Invoice.InvokeAsync(rec)">@L.S("Invoice…", "Faktura…")</button>
            <button class="@(armed == rec ? "accent" : "")" @onclick="() => DeleteClicked(rec, rows)">@(armed == rec ? ConfirmText : L.S("Delete", "Slet"))</button>
        </div>;
    }

    async Task SetView(int v)
    {
        if (WebHistory.View(Settings) == v) return;
        Settings.HistoryView = v;
        opened = null;
        await SettingsChanged.InvokeAsync();
    }

    void ToggleSelectMode()
    {
        selectMode = !selectMode;
        if (selectMode) opened = null;
        else ticked.Clear();
    }

    void Tick(QuoteRecord r)
    {
        if (!ticked.Remove(r)) ticked.Add(r);
    }

    void TickAll(List<QuoteRecord> rows, bool allTicked)
    {
        ticked.Clear();
        if (!allTicked) foreach (var r in rows) ticked.Add(r);
    }

    void ClearTicks() { ticked.Clear(); }

    void PhoneTap(QuoteRecord r)
    {
        if (selectMode) Tick(r); else ToggleOpen(r);
    }

    void TileTap(QuoteRecord r)
    {
        if (narrow == true) PhoneTap(r);
        else Select(r);
    }

    async Task TileKey(KeyboardEventArgs e, QuoteRecord r)
    {
        if (e.Key == "Enter") await OpenAgain.InvokeAsync(r);
        else if (e.Key == " ") Tick(r);
    }

    // the confirm dialog
    sealed class Confirm
    {
        public bool Clear;
        public List<QuoteRecord> Records;
        public DeleteSummary Summary;
    }

    Confirm confirm;
    bool keepCopy = true, busy;
    ElementReference dialogRef;
    bool holdPending, dialogHeld;

    void AskDelete(List<QuoteRecord> rows)
    {
        var recs = new List<QuoteRecord>();
        foreach (var r in rows) if (ticked.Contains(r)) recs.Add(r);   // list order (newest first) for the names
        if (recs.Count == 0) return;
        var ids = new List<string>();
        foreach (var r in recs) ids.Add(r.Id);
        var s = History.SummarizeDelete(Quotes, ids);
        s.Count = recs.Count;   // old records without an Id go too (by reference)
        confirm = new Confirm { Clear = false, Records = recs, Summary = s };
        holdPending = true;
    }

    void AskClear()
    {
        if (Quotes.Count == 0) return;
        keepCopy = true;
        confirm = new Confirm { Clear = true, Records = new List<QuoteRecord>(Quotes), Summary = History.SummarizeClear(Quotes) };
        holdPending = true;
    }

    void CancelConfirm() { if (!busy) confirm = null; }

    void ConfirmKey(KeyboardEventArgs e) { if (e.Key == "Escape") CancelConfirm(); }

    async Task ConfirmClicked()
    {
        if (confirm == null || busy) return;
        busy = true;
        try
        {
            var c = confirm;
            Disarm();
            if (c.Clear) await ClearAll.InvokeAsync(keepCopy && StorageAvailable);
            else await DeleteMany.InvokeAsync(c.Records);
            ticked.Clear();
            if (opened != null && !Quotes.Contains(opened)) opened = null;
            confirm = null;
        }
        finally { busy = false; }
    }

    async Task UndoClicked()
    {
        await Undo.InvokeAsync();
    }

    [JSInvokable]
    public void NarrowChanged(bool isNarrow)
    {
        if (narrow == isNarrow) return;
        narrow = isNarrow;
        StateHasChanged();
    }

    [JSInvokable]
    public void PrintMode(bool on)
    {
        if (printing == on) return;
        printing = on;
        StateHasChanged();
    }

    bool disposed;

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        try
        {
            if (module != null)
            {
                await module.InvokeVoidAsync("stopNarrow", watchKey);
                if (watchingPictures) await module.InvokeVoidAsync("stopPictures");
                if (dialogHeld) await module.InvokeVoidAsync("releaseDialog");
                await module.DisposeAsync();
            }
        }
        catch (Exception) { }
        if (self != null) self.Dispose();
    }

    protected override void OnInitialized()
    {
        filter.Month = WebHistory.StartMonth(Quotes);   // newest month with quotes, as HistoryForm
    }

    IEnumerable<QuoteRecord> Shown(List<QuoteRecord> rows)
    {
        for (int i = 0; i < rows.Count && i < shown; i++) yield return rows[i];
    }

    void MonthChosen(ChangeEventArgs e)
    {
        string v = (string)e.Value ?? "";
        DateTime m;
        filter.Month = DateTime.TryParseExact(v, "yyyy-MM", System.Globalization.CultureInfo.InvariantCulture,
                                              System.Globalization.DateTimeStyles.None, out m) ? m : DateTime.MinValue;
        shown = WebHistory.ShowStep;
    }

    // ‹ = older (+1 in the newest-first list), › = newer; from "All months" › does nothing, ‹ goes to the newest month
    void StepMonth(List<DateTime> months, int index, int step)
    {
        if (months.Count == 0) return;
        int i = index < 0 ? (step > 0 ? 0 : -1) : index + step;
        filter.Month = i < 0 ? DateTime.MinValue : months[Math.Min(i, months.Count - 1)];
        shown = WebHistory.ShowStep;
    }

    void Select(QuoteRecord r)
    {
        if (selected != r) Disarm();
        selected = r;
    }

    void ToggleOpen(QuoteRecord r)
    {
        if (opened != r) Disarm();
        opened = opened == r ? null : r;
        selected = r;
    }

    async Task RowKey(KeyboardEventArgs e, QuoteRecord r)
    {
        if (e.Key == "Enter") await OpenAgain.InvokeAsync(r);
        else if (e.Key == " " ) Select(r);
    }

    async Task ForChosen(QuoteRecord r, ChangeEventArgs e)
    {
        int f = (string)e.Value == "1" ? History.ForFriends : History.ForCustomer;
        if (f == r.For) return;
        r.For = f;   // the price shown follows For
        await Changed.InvokeAsync();
    }

    async Task NoteChanged(QuoteRecord r, ChangeEventArgs e)
    {
        string note = ((string)e.Value ?? "").Trim();
        if (note.Length > WebHistory.MaxNote) note = note.Substring(0, WebHistory.MaxNote);
        if (note == (r.Note ?? "")) return;
        r.Note = note;
        await Changed.InvokeAsync();
    }

    async Task TogglePrinted(QuoteRecord r)
    {
        selected = r;
        r.Printed = !r.Printed;
        await Changed.InvokeAsync();
    }

    async Task ToggleFailed(QuoteRecord r)
    {
        selected = r;
        History.MarkFailed(r, !r.Failed, DateTime.Now);
        await Changed.InvokeAsync();
    }

    /// Two clicks, as on the desktop: the first turns the button into a red "Really delete?" for 4 seconds.
    async Task DeleteClicked(QuoteRecord r, List<QuoteRecord> rows)
    {
        if (r == null) return;
        if (armed != r)
        {
            armed = r;
            int mine = ++armCount;
            _ = DisarmLater(mine);
            return;
        }
        Disarm();
        int index = rows.IndexOf(r);
        await DeleteMany.InvokeAsync(new List<QuoteRecord> { r });   // one Save, and Undo as for several
        if (Quotes.Contains(r)) return;   // not saved: it's back
        rows.Remove(r);
        ticked.Remove(r);
        selected = rows.Count == 0 ? null : rows[Math.Max(0, Math.Min(index, rows.Count - 1))];
        if (opened == r) opened = null;
    }

    async Task DisarmLater(int mine)
    {
        await Task.Delay(4000);
        if (mine != armCount || armed == null) return;
        armed = null;
        StateHasChanged();
    }

    void Disarm() { armed = null; armCount++; }
}
