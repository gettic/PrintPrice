    /// One export (MainForm.ExportQuote / ExportRecord): the quote goes into the history with this price and name (a
    /// saved quote gets them; an invoice also its number), then the page says what to print or copy.
    async Task<WebQuote.Done> ExportQuote(string kind, bool friends, string customer)
    {
        var d = new WebQuote.Done();
        customer = (customer ?? "").Trim();
        string err;
        string invoiceNo = null;
        if (quoteRecord != null)
        {
            var r = quoteRecord;
            if (kind == "history")
            {
                r.Customer = customer;
                r.For = friends ? History.ForFriends : History.ForCustomer;
            }
            else
            {
                if (quoteInvoice && customer.Length == 0) { d.Problem = WebQuote.NeedName; return d; }
                WebQuote.ApplyRecordExport(history, r, friends, customer, quoteInvoice, DateTime.Now, settings);
                if (quoteInvoice) { invoiceNo = r.InvoiceNo; await SaveSettings(); }
            }
            err = await Histories.Save(history);
        }
        else
        {
            if (last == null || input == null) { d.Problem = L.S("Nothing to send yet.", "Der er ikke noget at sende endnu."); return d; }
            var saved = WebQuote.SaveExport(history, NewRecord(), friends, customer);
            savedId = saved.Id;   // left out of the payback debt from now on
            err = await Histories.Save(history);
            if (err == null) await Histories.SavePicture(saved.Id, pictureUrl);
            DateTime when;
            quoteWhen = History.TryTime(saved.SavedAt, out when) ? when : DateTime.Now;
            Recalculate();
        }
        if (err != null) historyProblem = err;
        bool ok = err == null;
        if (kind == "history")
        {
            if (!ok) d.Problem = err;
            else d.Status = L.S("✓ Saved to history.", "✓ Gemt i historikken.");
        }
        else if (kind == "text")
        {
            d.Text = quoteRecord != null
                ? QuoteRows.RecordText(quoteRecord, friends, quoteInvoice, settings, WebQuote.ShortLink(quoteRecord.Source))
                : QuoteRows.JobText(customer, jobSource ?? "", input.Hours, input.Minutes, grams, Multi ? rows.Count : 0, last.FriendsPrice, last.OthersPrice);
            d.Status = WebQuote.CopiedText(quoteInvoice, invoiceNo, ok) + (ok ? "" : " " + err);
        }
        else
        {
            d.FileName = WebQuote.FileName(BuildQuoteSheet(friends, customer));
            d.Status = WebQuote.PrintedText(quoteInvoice, invoiceNo, ok) + (ok ? "" : " " + err);
        }
        StateHasChanged();   // the History page and the tab count behind the window
        return d;
    }

