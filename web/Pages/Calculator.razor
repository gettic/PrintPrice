@* The calculator: print time, grams, kr/kg and electricity -> both prices + the cost breakdown.
   Price code = the desktop app's Pricing (linked). Settings live in this browser's storage. *@
@inject Store Store
@inject HistoryStore Histories
@implements IDisposable

@if (!ready)
{
    <div class="loading"><div class="loading-text">Loading… / Indlæser…</div></div>
}
else
{
    <div class="@(InHistory ? "page wide" : "page")">
        <div class="top">
            <img src="icon-192.png" alt="" />
            <h1>@Title</h1>
            <nav class="nav" aria-label="@L.S("Pages", "Sider")">
                <a href="#" class="@(InHistory ? "" : "on")" aria-current="@(InHistory ? null : "page")" @onclick="ShowCalculator" @onclick:preventDefault="true">@L.S("Calculator", "Beregner")</a>
                <a href="#history" class="@(InHistory ? "on" : "")" aria-current="@(InHistory ? "page" : null)" @onclick="ShowHistory" @onclick:preventDefault="true">@L.F("History ({0})", "Historik ({0})", history.Count)</a>
            </nav>
            <div class="lang" role="group" aria-label="@L.S("Language", "Sprog")">
                <button class="@(L.Danish ? "" : "on")" aria-pressed="@(!L.Danish)" @onclick='() => SetLanguage("en")'>EN</button>
                <button class="@(L.Danish ? "on" : "")" aria-pressed="@L.Danish" @onclick='() => SetLanguage("da")'>DA</button>
            </div>
        </div>

        @if (InHistory)
        {
            <HistoryPage Quotes="history" Settings="settings" Problem="@historyProblem" Changed="HistoryChanged"
                         OpenAgain="r => FromHistory(r, false)" Repeat="r => FromHistory(r, true)"
                         LastBackup="@lastBackup" OpenBackup="() => OpenBackup(history.Count == 0 ? BackupDialog.TabRestore : BackupDialog.TabBackup)" />
        }

        <div class="calc" hidden="@InHistory">
        <div class="drop">
            <div class="pic">
                @if (pictureUrl != null)
                {
                    <img src="@pictureUrl" alt="@L.S("Model picture", "Billede af modellen")" />
                }
                else
                {
                    <span>@L.S("No model yet", "Ingen model")</span>
                }
            </div>
            <div class="zone">
                <div class="zone-row">
                    <button @onclick="ChooseFile" disabled="@reading">@L.S("Choose file…", "Vælg fil…")</button>
                    <span class="muted">@L.S("or drop a sliced .gcode.3mf / G-code here", "eller slip en slicet .gcode.3mf / G-code her")</span>
                </div>
                <input type="file" @ref="fileInput" class="hidden-file" tabindex="-1" aria-hidden="true"
                       accept=".3mf,.gcode,.gco,.stl,.obj,.step,.stp,.amf" />
                <input type="file" id="backupFile" class="hidden-file" tabindex="-1" aria-hidden="true" accept=".printprice-backup,.json" />
                @if (fileText != null)
                {
                    <div class="@(fileError ? "file-msg error" : "file-msg")" role="status">@fileText</div>
                }
                @if (printerWarning != null)
                {
                    <div class="file-warn">⚠ @printerWarning
                        @if (switchPrinter != null)
                        {
                            @(" ")<a href="" @onclick="UseFilePrinter" @onclick:preventDefault="true">@L.F("Use \"{0}\" for this quote", "Brug \"{0}\" til dette tilbud", switchPrinter.Name)</a>
                        }
                    </div>
                }
                @if (reopened != null || repeatOf != null)
                {
                    string main, muted;
                    if (repeatOf != null) WebHistory.RepeatLines(repeatOf, last, out main, out muted);
                    else WebHistory.ReopenLines(reopened, last, out main, out muted);
                    <div class="file-msg" role="status">@main<div class="muted-line">@muted</div>
                        @if (repeatOf != null && repeatHint) { <div class="muted-line">@WebHistory.RepeatHint</div> }
                    </div>
                }
            </div>
        </div>

        <div class="inputs">
            <label for="hours">@L.S("Print time", "Printtid")</label>
            <div class="field">
                <input id="hours" type="text" inputmode="numeric" class="small @Bad(hoursState)" value="@hours"
                       @oninput='e => { hours = (string)e.Value; Changed(); }' aria-label="@L.S("Hours", "Timer")" />
                <span>@L.S("h", "t")</span>
                <input type="text" inputmode="numeric" class="small @Bad(minutesState)" value="@minutes"
                       @oninput='e => { minutes = (string)e.Value; Changed(); }' aria-label="@L.S("Minutes", "Minutter")" />
                <span>m</span>
            </div>
            <div class="printer-card" tabindex="0" role="button" title="@L.S("Printer settings", "Printerindstillinger")"
                 @onclick='() => OpenSettings(SettingsDialog.TabPrinter)' @onkeydown="CardKey">
                <div class="name">@AppSettings.CleanPrinterName(settings.PrinterName)</div>
                <div>@Wear.FindModel(settings.PrinterModel).Label.Replace("Bambu Lab ", "") · @Num.Fmt(settings.PrinterWatts) W</div>
                <div>@L.F("{0} kr/h wear", "{0} kr/t slid", Num.Fmt(settings.MachineRatePerHour))</div>
            </div>

            <label for="grams">@L.S("Filament used", "Filamentforbrug")</label>
            <div class="field">
                <input id="grams" type="text" inputmode="decimal" class="mid @Bad(gramsState)" value="@grams" readonly="@Multi"
                       title="@(Multi ? L.S("The sum of the colours below", "Summen af farverne nedenfor") : null)"
                       @oninput='e => { grams = (string)e.Value; Changed(); }' />
                <span class="unit">g</span>
            </div>

            @if (!Multi)
            {
                <label for="kg">@L.S("Filament price", "Filamentpris")</label>
                <div class="field">
                    <input id="kg" type="text" inputmode="decimal" class="mid @Bad(kgState)" value="@perKg"
                           @oninput='e => { perKg = (string)e.Value; Changed(); }' />
                    <span class="unit">kr/kg</span>
                </div>
            }

            <label for="elec">@L.S("Electricity price", "Elpris")</label>
            <div class="field">
                <input id="elec" type="text" inputmode="decimal" class="mid @Bad(elecState)" value="@elec"
                       @oninput='e => { elec = (string)e.Value; Changed(); }' />
                <span class="unit">kr/kWh</span>
            </div>

            <div class="power">
                <button @onclick="FetchPower" disabled="@fetchingPower"
                        title="@L.S("Fetch the current electricity price", "Hent den aktuelle elpris")">@L.S("Update", "Opdatér")</button>
                <div class="@(powerError ? "power-line error" : "power-line")" role="status">@powerLine</div>
            </div>
        </div>

        @if (problem != null)
        {
            <div class="problem" role="alert">@problem</div>
        }

        <fieldset>
            <legend>@L.S("Cost breakdown", "Omkostninger")</legend>
            @if (Multi)
            {
                <div class="colours">
                    @for (int i = 0; i < rows.Count; i++)
                    {
                        int n = i;
                        var r = rows[n];
                        <span class="swatch" style="@Swatch(r.Use.Colour)" title="@r.Use.Colour"></span>
                        <span class="cname" title="@r.Use.Profile">@r.Name</span>
                        <span class="num">@Grams2(r.Use.Grams) g</span>
                        <span class="x">×</span>
                        <input type="text" inputmode="decimal" class="@Bad(r.State)" value="@r.PerKg" aria-label="@L.F("{0}, kr/kg", "{0}, kr/kg", r.Name)"
                               @oninput='e => { rows[n].PerKg = (string)e.Value; RowPriceChanged(n); }' />
                        <span>kr/kg</span>
                        <span class="num">@(last != null && last.FilamentCosts != null && n < last.FilamentCosts.Length ? Num.Kr(last.FilamentCosts[n]) : "–")</span>
                    }
                </div>
            }
            <div class="rows">
                @if (!Multi)
                {
                    <div>@L.S("Material", "Materiale") <span class="detail">@(materialName != null ? materialName + " · " : "")@(last == null ? "" : Num.Fmt(input.FilamentGrams) + " g × " + Num.Fmt(input.FilamentDkkPerKg) + " kr/kg")</span></div>
                    <div class="amount">@Kr(last?.MaterialCost)</div>
                }
                <div>@L.S("Power", "Strøm") <span class="detail">@(last == null ? "" : "(" + last.PowerKwh.ToString("N2", Num.Dk) + " kWh)")</span></div>
                <div class="amount">@Kr(last?.PowerCost)</div>
                @if (settings.FailedPrintPct > 0)
                {
                    <div>@L.F("Failed prints (+{0} %)", "Fejlprint (+{0} %)", Num.Fmt(settings.FailedPrintPct))</div>
                    <div class="amount">@Kr(last?.FailedPrintCost)</div>
                }
                <div class="line"></div>
                <div class="bold">@L.S("Base cost", "Kostpris")</div>
                <div class="amount bold">@Kr(last?.BaseCost)</div>
                @if (WebHistory.PaybackCaption(last) != null)
                {
                    <div>@WebHistory.PaybackCaption(last)</div>
                    <div class="amount">@WebHistory.PaybackAmount(last)</div>
                }
            </div>
        </fieldset>

        <div class="prices">
            <fieldset class="price friends">
                <legend>@L.S("Friends & family", "Venner og familie")</legend>
                <div class="big" aria-live="polite">@Kr(last?.FriendsPrice)</div>
                <div class="info">@FriendsInfo</div>
                @if (last != null) { @Lines(true) }
            </fieldset>
            <fieldset class="price others">
                <legend>@L.S("Customers", "Kunder")</legend>
                <div class="big" aria-live="polite">@Kr(last?.OthersPrice)</div>
                <div class="info">@OthersInfo</div>
                @if (last != null) { @Lines(false) }
            </fieldset>
        </div>

        <div class="bottom">
            <div class="made">@L.S("Made by Gettic", "Lavet af Gettic") · <a href="https://github.com/gettic/PrintPrice" target="_blank" rel="noopener">GitHub</a></div>
            <button @onclick="Clear">@L.S("Clear", "Ryd")</button>
            <button @onclick='() => OpenSettings(SettingsDialog.TabPrices)'>@L.S("Settings", "Indstillinger")</button>
            <button @onclick="SaveClicked" disabled="@(last == null)">@L.S("Save to history", "Gem i historik")</button>
        </div>
        @if (status != null)
        {
            <div class="@(statusError ? "status error" : "status")" role="status">@status</div>
        }
        <div class="note">@L.S("Your settings, price history and files stay in this browser. Online backup sends only a locked copy, and only when you use it. The live electricity price is asked from PrintPrice's relay.",
                               "Dine indstillinger, prishistorik og filer bliver i denne browser. Online-kopi sender kun en låst kopi, og kun når du bruger den. Den aktuelle elpris hentes via PrintPrices relæ.")</div>
        </div>
    </div>

    @if (backupOpen)
    {
        <BackupDialog Quotes="history" Settings="settings" StartTab="backupTab" PendingId="pendingId" PendingName="@pendingName"
                      PendingBytes="pendingBytes" OnClose="() => backupOpen = false" Apply="ApplyRestore" BackedUp="BackedUp" />
    }

    @if (settingsOpen)
    {
        <SettingsDialog Settings="settings" FilamentType="prefs.FilamentType" StartTab="settingsTab"
                        BrowserDanish="browserDanish" OnClose="SettingsClosed" />
    }
}

@code {
    bool ready, settingsOpen, browserDanish;
    int settingsTab;
    AppSettings settings;
    WebCalc.Prefs prefs;
    string hours = "", minutes = "", grams = "", perKg = "", elec = "";
    FieldState hoursState, minutesState, gramsState, kgState, elecState;
    QuoteInput input;
    QuoteResult last;
    string problem;

    // ---------- stage 2: a sliced file ----------
    sealed class ColourRow
    {
        public FilamentUse Use;
        public string Name, PerKg;
        public FieldState State;
    }

    ElementReference fileInput;
    DotNetObjectReference<Calculator> self;
    bool hooked, reading, fileError;
    int fileId;                        // the newest chosen file; older reads are dropped
    string fileText, printerWarning, pictureUrl;
    string materialName;               // one colour from a file: its material (kr/kg remembered under it)
    PrinterProfile switchPrinter;      // a printer in Settings with the file's model
    SliceResult fileResult;            // the file's values (printer check again after Settings)
    List<ColourRow> rows = new List<ColourRow>();   // 2+ colours from a file

    bool Multi { get { return rows.Count >= 2; } }

    // ---------- live electricity price ----------
    bool fetchingPower, powerError, powerStarted;
    string powerLine;

    // ---------- stage 3: price history ----------
    List<QuoteRecord> history = new List<QuoteRecord>();   // newest first; the History page edits this same list
    string historyProblem;             // storage / load / save problem shown on the History page
    string view = "calc";              // "calc" or "history" (#history in the address)
    bool pageHooked;
    DotNetObjectReference<Calculator> pageRef;
    string jobModel;                   // the record's model name: the dropped file's name, or the reopened record's
    FilamentUse single;                // one colour from a file / a reopened record: its material (saved with the quote)
    double jobPurge = -1;              // 2+ colours: purge grams of the file
    QuoteRecord reopened, repeatOf;    // Open again / Repeat print (their lines in the file box)
    bool repeatHint;                   // "drop the sliced file again" until a file is dropped
    string savedId;                    // the record Save made (left out of the payback debt)
    string elecToday;                  // today's electricity box value while a reopened quote shows its saved price
    string status;                     // "✓ Saved to history." / an error, under the buttons
    bool statusError;
    int statusCount;

    // ---------- stage 3b: backup ----------
    bool backupOpen;
    int backupTab, pendingId;
    string pendingName;
    byte[] pendingBytes;               // a backup file chosen / dropped (Restore)
    string lastBackup;                 // WebBackup.LastBackupValue, "" = never

    bool InHistory { get { return view == "history"; } }

    string Title { get { return L.S("Gettic's 3D Print Price Calculator", "Gettics 3D-print prisberegner"); } }

    protected override async Task OnInitializedAsync()
    {
        bool upgraded;
        settings = WebCalc.SettingsFromText(await Store.Get(Store.SettingsKey), out upgraded);
        prefs = WebCalc.Prefs.FromText(await Store.Get(Store.PrefsKey));
        if (upgraded) await SaveSettings();
        string lang = (await Store.BrowserLanguage() ?? "").ToLowerInvariant();
        browserDanish = lang.StartsWith("da") || lang.StartsWith("nb") || lang.StartsWith("no");
        WebCalc.ApplyAutoWear(settings, prefs.FilamentType);   // as the desktop does at startup
        ApplyLanguage();
        hours = prefs.Hours; minutes = prefs.Minutes; grams = prefs.Grams;
        perKg = Num.Fmt(settings.LastFilamentPrice);
        elec = Num.Fmt(settings.LastElectricityPrice);
        history = await Histories.Load(p => historyProblem = p);
        if (History.ReservePrinterIds(history, settings)) await SaveSettings();   // a new printer never reuses an id from the history
        Recalculate();
        string hash = await Store.Hash();   // a link to ...#settings / #printer / #language opens Settings there
        lastBackup = await Store.Get(WebBackup.LastBackupKey) ?? "";
        if (hash == "#history") view = "history";
        else if (hash == "#backup" || hash == "#restore") { view = "history"; OpenBackup(hash == "#restore" ? BackupDialog.TabRestore : BackupDialog.TabBackup); }
        else if (hash == "#settings") OpenSettings(SettingsDialog.TabPrices);
        else if (hash == "#printer") OpenSettings(SettingsDialog.TabPrinter);
        else if (hash == "#electricity") OpenSettings(SettingsDialog.TabElectricity);
        else if (hash == "#language") OpenSettings(SettingsDialog.TabApp);
        ready = true;
        await Store.SetPageLanguage(L.Danish, Title);
    }

    void ApplyLanguage()
    {
        L.Danish = settings.Language == "da" || (settings.Language != "en" && browserDanish);
    }

    async Task SetLanguage(string lang)
    {
        settings.Language = lang;
        ApplyLanguage();
        Recalculate();   // the problem text is in the language
        await SaveSettings();
        await Store.SetPageLanguage(L.Danish, Title);
    }

    async void Changed()
    {
        Recalculate();
        // remember the job and the last prices (only valid values, like the desktop's SaveLastPrices)
        prefs.Hours = hours; prefs.Minutes = minutes; prefs.Grams = grams;
        double v;
        if (!Multi && WebCalc.Read(perKg, out v) == FieldState.Ok)
        {
            settings.LastFilamentPrice = v;
            if (materialName != null) settings.RememberPrice(materialName, v);   // as the desktop's RememberRowPrice
        }
        if (WebCalc.Read(elec, out v) == FieldState.Ok) settings.LastElectricityPrice = v;
        await Store.Set(Store.PrefsKey, prefs.ToText());
        await SaveSettings();
    }

    Task SaveSettings() { return Store.Set(Store.SettingsKey, WebCalc.SettingsToText(settings)); }

    void Recalculate()
    {
        int h, m;
        double g, kg = 0, el;
        hoursState = WebCalc.ReadInt(hours, 999, out h);
        minutesState = WebCalc.ReadInt(minutes, 59, out m);
        gramsState = WebCalc.Read(grams, out g);
        kgState = Multi ? FieldState.Ok : WebCalc.Read(perKg, out kg);
        elecState = WebCalc.Read(elec, out el);
        bool rowsBad = false;
        List<FilamentLine> lines = null;
        if (Multi)
        {
            lines = new List<FilamentLine>();
            foreach (var r in rows)
            {
                double p;
                r.State = WebCalc.Read(r.PerKg, out p);
                if (r.State != FieldState.Ok) rowsBad = true;
                lines.Add(new FilamentLine { Grams = r.Use.Grams, PricePerKg = p });
            }
            kg = lines[0].PricePerKg;
        }
        problem = null;
        last = null;
        if (hoursState == FieldState.Invalid || minutesState == FieldState.Invalid)
            problem = L.S("Print time: hours 0–999, minutes 0–59.", "Printtid: timer 0–999, minutter 0–59.");
        else if (gramsState == FieldState.Invalid || kgState == FieldState.Invalid || elecState == FieldState.Invalid || rowsBad)
            problem = L.S("Please enter valid, non-negative numbers.", "Indtast gyldige tal, ikke negative.");
        if (problem != null) return;
        input = new QuoteInput { Hours = h, Minutes = m, FilamentGrams = g, FilamentDkkPerKg = kg, ElectricityDkkPerKwh = el, Filaments = lines };
        // failed prints payback (MainForm.PaybackDebt): the history's unpaid failed prints, without the quote Save made
        input.PaybackDebt = settings.FailedPayback != 0 ? History.FailedDebt(history, savedId) : 0;
        last = Pricing.Calculate(input, settings);
    }

    void Clear()
    {
        hours = minutes = grams = "";
        ClearJob();
        Changed();
    }

    void ClearJob()
    {
        fileId++;   // a read still running is dropped
        reading = false;
        rows.Clear();
        materialName = null;
        fileResult = null;
        fileText = printerWarning = pictureUrl = null;
        switchPrinter = null;
        fileError = false;
        single = null;
        jobPurge = -1;
        jobModel = null;
        reopened = repeatOf = null;   // the "Opened from history" lines go with the job
        repeatHint = false;
        savedId = null;
        if (elecToday != null) { elec = elecToday; elecToday = null; }   // the saved electricity price was only for that quote
    }

    void RowPriceChanged(int i)
    {
        Recalculate();
        double v;
        if (WebCalc.Read(rows[i].PerKg, out v) == FieldState.Ok)
        {
            settings.RememberPrice(rows[i].Name, v);
            settings.LastFilamentPrice = v;
            _ = SaveSettings();
        }
    }

    // ---------- stage 2: reading a sliced file ----------

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ready && !hooked)
        {
            hooked = true;
            self = DotNetObjectReference.Create(this);
            await Store.HookFiles(self, fileInput);
        }
        if (ready && !pageHooked)
        {
            pageHooked = true;
            pageRef = DotNetObjectReference.Create(this);
            await Store.HookPage(pageRef);
            await Store.HookBackupInput();
            _ = Histories.CleanPictures(history);
        }
        if (ready && !powerStarted)
        {
            powerStarted = true;   // once per page open, as the desktop does at startup (no timer)
            if (settings.AutoPowerPrice != 0) await FetchPower();
            else { powerLine = PowerOffText; StateHasChanged(); }
        }
    }

    Task ChooseFile() { return Store.PickFile(); }

    static string PowerOffText
    {
        get { return L.S("Live price is off (Settings). Click Update to fetch it once.", "Live-pris er slået fra (Indstillinger). Klik Opdatér for at hente den én gang."); }
    }

    // MainForm.FetchPowerPrice on the web: one try, no retry timer; failure = the typed / last price stays
    async Task FetchPower()
    {
        if (fetchingPower) return;
        fetchingPower = true;
        string area = settings.PriceArea;
        double addOn = settings.PowerAddOn;
        bool vat = settings.PowerIncludeVat != 0;
        string before = elec;
        powerError = false;
        powerLine = L.F("Fetching the current electricity price for {0}…", "Henter den aktuelle elpris for {0}…", area);
        StateHasChanged();
        try
        {
            var answer = await Store.FetchPower(area);
            var r = LivePower.Interpret(answer, area, DateTime.UtcNow, addOn, vat);
            bool applied = r.Ok && elec == before;
            if (applied)
            {
                elec = r.Total.ToString("0.00", Num.Dk);
                Changed();   // recalculates and remembers it as the last price
            }
            powerError = !r.Ok;
            powerLine = LivePower.Line(r, addOn, vat, applied, t => t.ToLocalTime(), DateTime.Now);
        }
        finally
        {
            fetchingPower = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task FileChosen(int id, string name, double size, int count)
    {
        if (WebBackup.IsBackupName(name)) { await BackupFileChosen(id, name, (long)size); return; }   // Restore, not a sliced file
        var repeat = repeatOf;   // a repeat print stays one when its sliced file is dropped again (the hint asks for it)
        ClearJob();
        int mine = fileId = id;
        reading = true;
        fileText = L.F("Reading \"{0}\"…", "Læser \"{0}\"…", name);
        StateHasChanged();
        var job = await SlicedFile.Read(Store.File(id, (long)size), name, settings.FilamentPreset);
        if (mine != fileId) return;   // another file was chosen meanwhile, or Clear
        reading = false;
        if (repeat != null && job.Result != null) WebHistory.KeepSavedMaterials(job.Result, repeat);
        ShowJob(job, count);
        if (repeat != null && job.Result != null) { repeatOf = repeat; Recalculate(); }
        await Store.Set(Store.PrefsKey, prefs.ToText());
        await SaveSettings();
        StateHasChanged();
    }

    void ShowJob(FileJob job, int count)
    {
        string more = count > 1 ? " " + L.S("(one file at a time: used the first)", "(én fil ad gangen: den første blev brugt)") : "";
        if (job.Unsliced)
        {
            fileError = false;   // a hint, not an error (as in the approved mock-up)
            fileText = L.F("\"{0}\" isn't sliced, and a website can't slice. In Bambu Studio: Slice plate, then File → Export → Export plate sliced file, and drop that file here. Or type the time and grams below.",
                           "\"{0}\" er ikke slicet, og en hjemmeside kan ikke slice. I Bambu Studio: Slice plade, derefter Filer → Eksportér → Eksportér pladens slicede fil, og slip den fil her. Eller skriv tid og gram nedenfor.",
                           job.FileName) + more;
            return;
        }
        if (job.Result == null)
        {
            fileError = true;
            fileText = job.Error + more;
            return;
        }
        var res = job.Result;
        // time and grams as the desktop fills them (MainForm.AnalyzeAsync)
        int totalMinutes = (int)Math.Round(res.Seconds / 60.0);
        if (totalMinutes == 0 && res.Seconds > 0) totalMinutes = 1;
        hours = (totalMinutes / 60).ToString(System.Globalization.CultureInfo.InvariantCulture);
        minutes = (totalMinutes % 60).ToString(System.Globalization.CultureInfo.InvariantCulture);
        var used = res.Filaments.FindAll(f => f != null && f.Grams > 0);
        bool multi = used.Count >= 2;
        grams = multi ? Math.Round(res.Grams, 2).ToString("0.##", Num.Dk) : Math.Round(res.Grams, 1).ToString("0.#", Num.Dk);
        if (multi)
        {
            foreach (var f in used)
            {
                string n = MaterialName(f);
                rows.Add(new ColourRow { Use = f, Name = n, PerKg = Num.Fmt(settings.PriceFor(n)) });
            }
        }
        else
        {
            // one colour: its material (Settings' filament when the file names none), kr/kg remembered for it
            materialName = used.Count == 1 && (used[0].Profile.Length > 0 || used[0].Type.Length > 0) ? MaterialName(used[0]) : settings.FilamentPreset;
            perKg = Num.Fmt(settings.PriceFor(materialName));
            single = used.Count == 1 ? used[0] : null;
        }
        jobModel = job.FileName;
        jobPurge = multi ? res.PurgeGrams : -1;
        prefs.Hours = hours; prefs.Minutes = minutes; prefs.Grams = grams;
        if (res.Picture != null && job.PictureType != null)
            pictureUrl = "data:" + job.PictureType + ";base64," + Convert.ToBase64String(res.Picture);
        fileError = false;
        fileText = L.F("✓ \"{0}\": {1} h {2} m, {3} g", "✓ \"{0}\": {1} t {2} m, {3} g", job.FileName, hours, minutes, grams)
                   + " (" + L.S("read from the sliced file", "læst fra den slicede fil")
                   + (multi ? " · " + L.F("{0} colours", "{0} farver", rows.Count) : "") + ")." + more;
        fileResult = res;
        CheckPrinter(res);
        Recalculate();
    }

    // file sliced for another supported printer: warn, and offer a printer of that model from Settings
    void CheckPrinter(SliceResult res)
    {
        printerWarning = null;
        switchPrinter = null;
        if (string.IsNullOrEmpty(res.PrinterModel) || res.PrinterModel == settings.PrinterModel) return;
        printerWarning = L.F("The file was sliced for the {0}, not the {1}: its time and weight are for that printer.",
                             "Filen er slicet til {0}, ikke {1}: dens tid og vægt gælder for den printer.",
                             BambuSlicer.FindPrinter(res.PrinterModel).MachineName, Wear.FindModel(settings.PrinterModel).Label);
        foreach (var p in settings.Printers)
            if (p.Model == res.PrinterModel) { switchPrinter = p; break; }
    }

    async Task UseFilePrinter()
    {
        if (switchPrinter == null || !settings.SelectPrinter(switchPrinter.Id)) return;
        WebCalc.ApplyAutoWear(settings, prefs.FilamentType);
        printerWarning = null;
        switchPrinter = null;
        Recalculate();
        await SaveSettings();
    }

    static string MaterialName(FilamentUse f) { return WebHistory.MaterialName(f); }

    static string Swatch(string colour)
    {
        return "background:" + (string.IsNullOrEmpty(colour) ? "transparent" : colour);
    }

    static string Grams2(double g) { return Math.Round(g, 2).ToString("0.##", Num.Dk); }

    public void Dispose()
    {
        if (self != null) self.Dispose();
        if (pageRef != null) pageRef.Dispose();
    }

    // ---------- stage 3: price history ----------

    void ShowCalculator() { view = "calc"; _ = Store.Go(""); }

    void ShowHistory()
    {
        view = "history";
        _ = Store.Go("#history");
    }

    /// Back / Forward and #history links (window hashchange).
    [JSInvokable]
    public void HashChanged(string hash)
    {
        string v = hash == "#history" ? "history" : "calc";
        if (v == view) return;
        view = v;
        StateHasChanged();
    }

    /// Another open tab of the site saved the history: read it again (no edits get lost between two tabs).
    [JSInvokable]
    public async Task HistoryChangedElsewhere()
    {
        var fresh = await Histories.Load(p => historyProblem = p);
        history.Clear();   // the same list object: the History page keeps its reference
        history.AddRange(fresh);
        if (reopened != null && !history.Exists(r => r.Id == reopened.Id)) reopened = null;
        Recalculate();
        StateHasChanged();
    }

    /// The History page changed a record or deleted one: save at once; the payback debt may have changed.
    async Task HistoryChanged()
    {
        string err = await Histories.Save(history);
        historyProblem = err ?? (Histories.Available ? null : historyProblem);
        Recalculate();
    }

    async Task SaveClicked()
    {
        if (last == null || input == null)
        {
            ShowStatus(L.S("Nothing to save yet.", "Der er ikke noget at gemme endnu."), true);
            return;
        }
        List<HistoryFilament> materials;
        if (Multi)
        {
            materials = new List<HistoryFilament>();
            foreach (var r in rows) materials.Add(new HistoryFilament { Colour = r.Use.Colour ?? "", Type = r.Use.Type ?? "", Name = r.Use.Profile ?? "" });
        }
        else materials = new List<HistoryFilament> { WebHistory.SingleMaterial(single, materialName, prefs.FilamentType) };
        var rec = WebHistory.MakeRecord(input, last, settings, jobModel, DateTime.Now, materials, jobPurge, reopened, repeatOf);
        var saved = WebHistory.Save(history, rec);
        savedId = saved.Id;   // left out of the payback debt from now on (same price when saved again)
        string err = await Histories.Save(history);
        if (err == null) await Histories.SavePicture(saved.Id, pictureUrl);
        Recalculate();
        if (err != null) { historyProblem = err; ShowStatus(err, true); }
        else if (!Histories.Available) ShowStatus(L.S("✓ Saved to history (until this page is closed: this browser keeps no storage).",
                                                      "✓ Gemt i historikken (til siden lukkes: denne browser gemmer ikke)."), false);
        else ShowStatus(L.S("✓ Saved to history.", "✓ Gemt i historikken."), false);
    }

    void ShowStatus(string text, bool error)
    {
        status = text;
        statusError = error;
        int mine = ++statusCount;
        _ = HideStatusLater(mine, error ? 8000 : 4000);
    }

    async Task HideStatusLater(int mine, int ms)
    {
        await Task.Delay(ms);
        if (mine != statusCount) return;
        status = null;
        StateHasChanged();
    }

    /// Open again (repeat false) or Repeat print from the History page (MainForm.Reopen / Repeat + FillFromRecord):
    /// back to the calculator with the record's time, grams and colours; Open again = its saved kr/kg and electricity,
    /// Repeat print = today's kr/kg per material and today's electricity (live price when on). No slicing on the web.
    async Task FromHistory(QuoteRecord r, bool repeat)
    {
        if (r == null) return;
        ClearJob();   // also gives back today's electricity after an earlier Open again
        UseRecordPrinter(r);
        var f = WebHistory.FillFrom(r, repeat, settings);
        hours = f.Hours; minutes = f.Minutes; grams = f.Grams;
        foreach (var row in f.Rows) rows.Add(new ColourRow { Use = row.Use, Name = row.Name, PerKg = row.PerKg });
        if (rows.Count == 0) perKg = f.PerKg;
        single = f.Single;
        materialName = f.MaterialName;
        jobPurge = f.PurgeGrams;
        jobModel = string.IsNullOrEmpty(r.Model) ? null : r.Model;
        if (!repeat)
        {
            elecToday = elec;   // today's value comes back with Clear / a new file
            elec = f.Elec;
            reopened = r;
        }
        else
        {
            repeatOf = r;
            repeatHint = true;
        }
        powerError = false;
        powerLine = WebHistory.ElecLine(r, repeat);
        prefs.Hours = hours; prefs.Minutes = minutes; prefs.Grams = grams;
        Recalculate();
        view = "calc";
        await Store.Go("");
        await Store.ToTop();
        pictureUrl = await Histories.Picture(r.Id);
        await Store.Set(Store.PrefsKey, prefs.ToText());
        StateHasChanged();
        if (repeat && settings.AutoPowerPrice != 0) await FetchPower();
    }

    // ---------- stage 3b: backup ----------

    void OpenBackup(int tab)
    {
        backupTab = tab;
        backupOpen = true;
    }

    /// A .printprice-backup / .json chosen in Restore or dropped anywhere: read whole (in 4 MB pieces) and shown in Restore.
    async Task BackupFileChosen(int id, string name, long size)
    {
        byte[] bytes = null;
        if (size <= WebBackup.MaxFileBytes)
        {
            var src = Store.File(id, size);
            bytes = new byte[size];
            long at = 0;
            while (at < size)
            {
                var part = await src.Read(at, (int)Math.Min(4 * 1024 * 1024, size - at));
                if (part.Length == 0) break;
                Buffer.BlockCopy(part, 0, bytes, (int)at, part.Length);
                at += part.Length;
            }
            if (at < size) bytes = new byte[0];
        }
        else bytes = new byte[WebBackup.MaxFileBytes + 1];   // ReadFile says it's too big
        pendingName = name;
        pendingBytes = bytes;
        pendingId++;
        backupTab = BackupDialog.TabRestore;
        backupOpen = true;
        StateHasChanged();
    }

    async Task BackedUp(bool online)
    {
        lastBackup = WebBackup.LastBackupValue(DateTime.Now, online);
        await Store.Set(WebBackup.LastBackupKey, lastBackup);
    }

    /// A restore made real (desktop History.Restore + MainForm.AdoptRestore): safety copy of what is here, then the
    /// history list (same object) and the settings become the restored ones, both saved.
    async Task<WebBackup.Applied> ApplyRestore(RestoreResult res, string safetyKey)
    {
        var a = new WebBackup.Applied();
        if (Histories.Available)
        {
            string err = await Histories.SaveSafety(safetyKey, WebBackup.FileText(history, settings, DateTime.Now));
            if (err != null) { a.Problem = err; return a; }
            a.SafetyKept = true;
        }
        history.Clear();
        history.AddRange(res.Quotes);
        if (res.Settings != null) settings = res.Settings;
        History.ReservePrinterIds(history, settings);
        WebCalc.ApplyAutoWear(settings, prefs.FilamentType);
        if (fileResult != null) CheckPrinter(fileResult);
        if (reopened != null && !history.Exists(r => r.Id == reopened.Id)) reopened = null;
        if (repeatOf != null && !history.Exists(r => r.Id == repeatOf.Id)) repeatOf = null;
        ApplyLanguage();
        Recalculate();
        a.Done = true;
        a.Problem = await Histories.Save(history);
        historyProblem = a.Problem;
        await SaveSettings();
        await Store.SetPageLanguage(L.Danish, Title);
        _ = Histories.CleanPictures(history);
        StateHasChanged();   // the History page behind the dialog shows the restored list at once
        return a;
    }

    /// The quote's printer, if it still exists in Settings (MainForm.UseRecordPrinter).
    void UseRecordPrinter(QuoteRecord r)
    {
        string id = History.PrinterOf(r);
        if (id == settings.ActivePrinterId || settings.FindPrinter(id) == null) return;
        if (!settings.SelectPrinter(id)) return;
        WebCalc.ApplyAutoWear(settings, prefs.FilamentType);
        _ = SaveSettings();
    }

    void OpenSettings(int tab) { settingsTab = tab; settingsOpen = true; }

    void CardKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ") OpenSettings(SettingsDialog.TabPrinter);
    }

    async Task SettingsClosed(SettingsDialog.Result r)
    {
        settingsOpen = false;
        if (r == null) return;   // cancelled
        bool powerChanged = r.Settings.PriceArea != settings.PriceArea || r.Settings.PowerAddOn != settings.PowerAddOn
                            || r.Settings.PowerIncludeVat != settings.PowerIncludeVat || r.Settings.AutoPowerPrice != settings.AutoPowerPrice;
        settings = r.Settings;
        prefs.FilamentType = r.FilamentType;
        WebCalc.ApplyAutoWear(settings, prefs.FilamentType);
        if (fileResult != null) CheckPrinter(fileResult);
        if (r.Reset) { perKg = Num.Fmt(settings.LastFilamentPrice); elec = Num.Fmt(settings.LastElectricityPrice); }
        ApplyLanguage();
        Recalculate();
        await SaveSettings();
        await Store.Set(Store.PrefsKey, prefs.ToText());
        await Store.SetPageLanguage(L.Danish, Title);
        // electricity settings changed: ask once more (on), or say it's off; never on a timer
        if (powerChanged)
        {
            if (settings.AutoPowerPrice != 0) await FetchPower();
            else { powerError = false; powerLine = PowerOffText; }
        }
    }

    static string Bad(FieldState s) { return s == FieldState.Invalid ? "invalid" : ""; }

    static string Kr(double? v) { return v.HasValue ? Num.Kr(v.Value) : "–"; }

    static string N2(double v) { return v.ToString("N2", Num.Dk); }

    string Wear_ { get { return settings.MachineRatePerHour > 0 ? L.F(", {0} kr/h wear", ", {0} kr/t slid", Num.Fmt(settings.MachineRatePerHour)) : ""; } }

    // the same lines as the desktop's price boxes (MainForm.RefreshSettingsLabels)
    string FriendsInfo { get { return L.F("+{0} % markup", "+{0} % avance", Num.Fmt(settings.FriendsMarkupPct)) + Wear_; } }

    string OthersInfo
    {
        get
        {
            if (settings.MinimumPrice > 0)
                return L.F("+{0} %", "+{0} %", Num.Fmt(settings.OthersMarkupPct)) + Wear_ + L.F(", min. {0} kr.", ", min. {0} kr.", Num.Fmt(settings.MinimumPrice));
            return L.F("+{0} % markup", "+{0} % avance", Num.Fmt(settings.OthersMarkupPct)) + Wear_;
        }
    }

    // ---------- line-by-line breakdown of one price (Pricing.Breakdown; texts as on the desktop quote page) ----------

    RenderFragment Lines(bool friends) => __builder =>
    {
        var wear = settings.AutoWearRate != 0 ? WebCalc.WearBreakdown(settings, prefs.FilamentType) : null;
        var b = Pricing.Breakdown(input, settings, friends, wear);
        <details>
            <summary>@L.S("How the price is made", "Sådan er prisen regnet ud")</summary>
            <div class="rows">
                @foreach (var l in b.Lines)
                {
                    <div>@LineName(l) <span class="detail">@LineDetail(l)</span></div>
                    <div class="amount">@Num.Kr(l.Amount)</div>
                    @if (l.Parts != null)
                    {
                        foreach (var p in l.Parts)
                        {
                            <div class="sub">@LineName(p)</div>
                            <div class="sub amount">@Num.Kr(p.Amount)</div>
                        }
                    }
                }
                <div class="line"></div>
                <div class="bold">@L.S("Total", "I alt")</div>
                <div class="amount bold">@Num.Kr(b.Total)</div>
            </div>
        </details>
    };

    string LineName(QuoteLine l)
    {
        switch (l.Key)
        {
            case QuoteLine.Material: return Multi && l.Index >= 0 && l.Index < rows.Count ? rows[l.Index].Name : L.S("Material", "Materiale");
            case QuoteLine.Power: return L.S("Electricity", "Strøm");
            case QuoteLine.Wear: return L.S("Machine wear", "Maskinslid");
            case QuoteLine.Failed: return L.S("Failed-print allowance", "Tillæg for fejlprint");
            case QuoteLine.Payback: return L.S("Earlier failed prints", "Tidligere fejlprint");
            case QuoteLine.Work: return L.S("Work & handling", "Arbejde & håndtering");
            case QuoteLine.Minimum: return L.S("Minimum price top-up", "Tillæg op til minimumspris");
            case QuoteLine.Rounding: return L.S("Rounding", "Afrunding");
            case QuoteLine.WearPrinter: return L.S("Printer", "Printer");
            case QuoteLine.WearParts: return L.S("Spare parts & upkeep", "Reservedele & vedligehold");
            case QuoteLine.WearHotend: return L.S("Nozzle / hotend", "Dyse / hotend");
            case QuoteLine.WearPlate: return L.S("Build plate", "Byggeplade");
        }
        return l.Key;
    }

    string LineDetail(QuoteLine l)
    {
        switch (l.Key)
        {
            case QuoteLine.Material: return Num.Fmt(l.Quantity) + " g × " + Num.Fmt(l.UnitPrice) + " kr/kg";
            case QuoteLine.Power: return N2(l.Quantity) + " kWh × " + N2(l.UnitPrice) + " kr/kWh";
            case QuoteLine.Wear: return input.Hours + L.S(" h ", " t ") + input.Minutes + " m × " + N2(l.UnitPrice) + L.S(" kr/h", " kr/t");
            case QuoteLine.Failed: return L.F("{0} % of material + electricity", "{0} % af materiale + strøm", Num.Fmt(l.Quantity));
            case QuoteLine.Work: return "+" + Num.Fmt(l.Quantity) + " %";
            case QuoteLine.Minimum: return L.F("lowest price {0} kr.", "laveste pris {0} kr.", Num.Fmt(l.Quantity));
            case QuoteLine.Rounding: return L.F("up to nearest {0} kr.", "op til nærmeste {0} kr.", Num.Fmt(l.Quantity));
        }
        return "";
    }
