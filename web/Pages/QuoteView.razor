@* The quote / invoice window (desktop QuoteForm) on the web: the A4 page on the left (scaled to fit), on the right the
   customer's name (recent names offered), which price goes on it, Light / Dark, and Print / PDF…, Copy text and Save to
   history. What an export saves is the Calculator's job (Export); the page only shows and prints. *@
@inject Store Store

<div class="qv" role="dialog" aria-modal="true" aria-labelledby="qv-title" @onkeydown="Key">
    <div class="qv-bar">
        <img src="icon-192.png" alt="" />
        <span id="qv-title">@WebQuote.WindowTitle(Invoice, Model)</span>
        <button @onclick="Close" aria-label="@L.S("Close", "Luk")">✕ @L.S("Close", "Luk")</button>
    </div>
    <div class="qv-body">
        <div class="@(zoomed ? "qv-preview zoomed" : "qv-preview")" title="@L.S("Click to zoom in or out", "Klik for at zoome ind eller ud")" @onclick="() => zoomed = !zoomed">
            <QuoteSheet Data="sheet" Dark="dark" />
        </div>
        <div class="qv-side">
            <label class="qv-head" for="qv-name">@(Invoice ? L.S("Customer (required)", "Kunde (skal udfyldes)") : L.S("Customer (optional)", "Kunde (valgfrit)"))</label>
            <input id="qv-name" type="text" class="left" list="qv-recent" maxlength="80" value="@customer" autocomplete="off"
                   readonly="@NameLocked" @oninput="NameTyped" />
            <datalist id="qv-recent">
                @foreach (var n in Recent) { <option value="@n"></option> }
            </datalist>
            @if (Recent.Count > 0)
            {
                <div class="qv-recent muted">@L.S("Recent: ", "Seneste: ")@string.Join(", ", Recent.Count > 3 ? Recent.GetRange(0, 3) : Recent)</div>
            }

            <div class="qv-head">@WebQuote.PriceHeading(Invoice, PriceLocked)</div>
            <div class="qv-choices" role="radiogroup">
                <button class="@(friends ? "qv-choice" : "qv-choice on")" role="radio" aria-checked="@(!friends)" disabled="@(PriceLocked && friends)" @onclick="() => SetFriends(false)">
                    <span>@L.S("Customers", "Kunder")</span><b class="red">@Num.Kr(CustomerPrice)</b></button>
                <button class="@(friends ? "qv-choice on" : "qv-choice")" role="radio" aria-checked="@friends" disabled="@(PriceLocked && !friends)" @onclick="() => SetFriends(true)">
                    <span>@L.S("Friends & family", "Venner og familie")</span><b class="green">@Num.Kr(FriendsPrice)</b></button>
            </div>

            <div class="qv-head">@L.S("Look on screen", "Udseende på skærmen")</div>
            <div class="qv-look" role="radiogroup">
                <button class="@(dark ? "on" : "")" role="radio" aria-checked="@dark" @onclick="() => SetDark(true)">@L.S("Dark", "Mørk")</button>
                <button class="@(dark ? "" : "on")" role="radio" aria-checked="@(!dark)" @onclick="() => SetDark(false)">@L.S("Light", "Lys")</button>
            </div>
            <div class="muted small">@L.S("The PDF is always light (for printing).", "PDF'en er altid lys (til print).")</div>

            @* print status (QuoteForm, issue #7): every window; a saved quote / invoice / combined bill saves a pick at
               once (StatusNow), the calculator's job stores it with its export. "Mixed" only while the prints differ. *@
            <label class="qv-head" for="qv-status">@(StatusHeading ?? WebQuote.StatusHeading)</label>
            <select id="qv-status" class="qv-status" value="@(mixed ? "4" : status_.ToString())" disabled="@statusBusy" @onchange="StatusChanged">
                @for (int i = 0; i < 4; i++) { int k = i; <option value="@k">@WebQuote.StatusNames[k]</option> }
                @if (mixed) { <option value="4">@WebStatus.Mixed</option> }
            </select>

            <div class="qv-actions">
                <button class="accent" disabled="@(busy || NeedsName)" @onclick='() => Run("print")'>@L.S("Print / PDF…", "Print / PDF…")</button>
                <button disabled="@(busy || NeedsName)" @onclick='() => Run("text")'>@L.S("Copy text", "Kopiér tekst")</button>
                <button class="wide" disabled="@busy" @onclick='() => Run("history")'>@L.S("Save to history", "Gem i historik")</button>
            </div>
            @if (status != null)
            {
                <div class="@(statusError ? "hinfo error" : "hinfo ok")" style="white-space:pre-wrap" role="status">@status</div>
            }
            @if (!string.IsNullOrEmpty(Warning))
            {
                <div class="hinfo warn" style="white-space:pre-wrap">@Warning</div>
            }
            @if (!string.IsNullOrEmpty(Note))
            {
                <div class="hinfo note" style="white-space:pre-wrap">@Note</div>
            }
            <div class="hinfo">@(Help ?? WebQuote.HelpText(IsRecord, Invoice, PriceLocked ? MadeNo : null))</div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Model { get; set; }
    [Parameter] public bool Invoice { get; set; }
    [Parameter] public bool IsRecord { get; set; }
    [Parameter] public List<string> Recent { get; set; }
    [Parameter] public double CustomerPrice { get; set; }
    [Parameter] public double FriendsPrice { get; set; }
    [Parameter] public bool StartFriends { get; set; }
    [Parameter] public bool StartDark { get; set; }
    [Parameter] public string StartCustomer { get; set; }
    /// A made invoice: the name it was made out to stays (read-only box), as on the desktop.
    [Parameter] public bool NameLocked { get; set; }
    /// A made invoice: its price stays the one it was billed at (LockedFriends), as QuoteForm.LockInvoice. Can turn on
    /// while the window is open (the first export of "Show invoice…" makes the invoice).
    [Parameter] public bool PriceLocked { get; set; }
    [Parameter] public bool LockedFriends { get; set; }
    /// The made invoice's number (for the help line).
    [Parameter] public string MadeNo { get; set; }
    /// The print status the window starts with (quotes: the job = Not printed yet, a saved quote = History.PrintStateOf).
    [Parameter] public PrintState StartStatus { get; set; }
    /// A warning line above the help (an invoice of a print marked as failed); null = none.
    [Parameter] public string Warning { get; set; }
    /// An info line above the help (combined bill: "the whole invoice is shown"); null = none.
    [Parameter] public string Note { get; set; }
    /// The help text (null = WebQuote.HelpText; combined bill: GroupHelpText).
    [Parameter] public string Help { get; set; }
    /// The status box's heading (null = "Print status"; combined: "Print status (all 3 prints)").
    [Parameter] public string StatusHeading { get; set; }
    /// A combined bill whose prints differ: the box starts at "Mixed".
    [Parameter] public bool StartMixed { get; set; }
    /// A saved record / combined bill: a pick is saved at once (the Done says the status afterwards); null = the pick
    /// goes with the next export (the calculator's job).
    [Parameter] public Func<PrintState, Task<WebQuote.Done>> StatusNow { get; set; }
    /// The page for (friends, customer).
    [Parameter] public Func<bool, string, WebQuote.Sheet> Build { get; set; }
    /// One export ("print", "text", "history") with (friends, customer, print status; null for an invoice): saves what it
    /// should and says what to print / copy.
    [Parameter] public Func<string, bool, string, PrintState?, Task<WebQuote.Done>> Export { get; set; }
    /// The price and look chosen (the job's quote remembers both in Settings, a saved quote only the look).
    [Parameter] public Func<bool, bool, Task> Remember { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    WebQuote.Sheet sheet;
    string customer = "", status, printTitle;
    bool friends, dark, busy, statusError, zoomed, mixed, statusBusy;
    int status_;   // the Print status box (PrintState as int; "status" is the message line)

    bool NeedsName { get { return Invoice && customer.Trim().Length == 0; } }

    protected override void OnInitialized()
    {
        friends = StartFriends;
        dark = StartDark;
        customer = StartCustomer ?? "";
        status_ = (int)StartStatus;
        mixed = StartMixed;
        Rebuild();
    }

    protected override void OnParametersSet()
    {
        // locked (now or since opening): the billed price is the only choice
        if (PriceLocked && friends != LockedFriends) { friends = LockedFriends; Rebuild(); }
    }

    void Rebuild() { sheet = Build(friends, customer); }

    void NameTyped(ChangeEventArgs e)
    {
        if (NameLocked) return;
        customer = (string)e.Value ?? "";
        Rebuild();
    }

    async Task SetFriends(bool f)
    {
        if (PriceLocked && f != LockedFriends) return;
        friends = f; Rebuild(); await Remember(friends, dark);
    }

    async Task SetDark(bool d)
    {
        dark = d;
        await Remember(friends, dark);
    }

    async Task Run(string kind)
    {
        if (busy) return;
        if (kind != "history" && NeedsName) { status = WebQuote.NeedName; statusError = true; return; }
        busy = true;
        // Copy text: the clipboard write starts here, inside the click (Safari / Firefox copy only then); the text
        // follows once the save is done, or nothing is copied when an invoice couldn't be saved
        if (kind == "text") Store.CopyStart();
        try
        {
            var done = await Export(kind, friends, customer, mixed ? (PrintState?)null : (PrintState)status_);
            Rebuild();   // a saved quote's number and date, an invoice's number
            TakeStatus(done);
            statusError = done.Problem != null;
            status = done.Problem ?? done.Status;
            if (done.Problem != null && kind == "text") await Store.CopyCancel();
            if (done.Problem == null)
            {
                if (kind == "text" && !await Store.CopyFinish(done.Text))
                {
                    statusError = true;
                    status = L.S("The browser didn't allow copying. Select the text below and copy it yourself.",
                                 "Browseren tillod ikke kopiering. Markér teksten og kopiér den selv.") + "\n\n" + done.Text;
                }
                if (kind == "print") printTitle = done.FileName;   // printed after this render (the new number on the page)
            }
        }
        finally { busy = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Store.FitSheet();
        if (printTitle != null)
        {
            string t = printTitle;
            printTitle = null;
            await Store.PrintSheet(t);
        }
    }

    /// The box after a save (the stored status; "Mixed" when the prints differ).
    void TakeStatus(WebQuote.Done done)
    {
        if (done == null || !done.HasStatus) return;
        mixed = done.Mixed;
        if (!mixed) status_ = (int)done.Status_;
    }

    async Task StatusChanged(ChangeEventArgs e)
    {
        int v;
        if (!int.TryParse((string)e.Value, out v) || v < 0 || v > 3) return;
        status_ = v;
        mixed = false;
        if (StatusNow == null) return;
        StateHasChanged();   // the pick on screen first, so a "No" or a failed save can put the old one back   // the job: stored with the next export
        statusBusy = true;
        try
        {
            var done = await StatusNow((PrintState)v);
            TakeStatus(done);
            if (done.Problem != null) { status = done.Problem; statusError = true; }
            else if (done.Status != null) { status = done.Status; statusError = false; }
        }
        finally { statusBusy = false; }
    }

    Task Close() { return OnClose.InvokeAsync(); }

    async Task Key(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }
}
